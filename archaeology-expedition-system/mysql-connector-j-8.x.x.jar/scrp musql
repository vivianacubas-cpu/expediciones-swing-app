-- =========================================
-- BASE DE DATOS: swing-cloud-expediciones
-- =========================================

CREATE DATABASE IF NOT EXISTS swing_cloud_expediciones;
USE swing_cloud_expediciones;

-- =========================================
-- TABLA: SITIO ARQUEOLOGICO
-- =========================================
CREATE TABLE sitio_arqueologico (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    pais VARCHAR(100) NOT NULL,
    anio_descubrimiento INT,
    estado_conservacion VARCHAR(100)
);

-- =========================================
-- TABLA: ARQUEOLOGO
-- =========================================
CREATE TABLE arqueologo (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    especialidad VARCHAR(100),
    nacionalidad VARCHAR(100),
    anios_experiencia INT
);

-- =========================================
-- TABLA: EXPEDICION
-- =========================================
CREATE TABLE expedicion (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    fecha_inicio DATE,
    fecha_fin DATE,
    sitio_id INT,

    FOREIGN KEY (sitio_id) REFERENCES sitio_arqueologico(id)
    ON DELETE SET NULL
);

-- =========================================
-- TABLA: HALLAZGO
-- =========================================
CREATE TABLE hallazgo (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    tipo VARCHAR(100),
    fecha_descubrimiento DATE,
    expedicion_id INT,

    FOREIGN KEY (expedicion_id) REFERENCES expedicion(id)
    ON DELETE SET NULL
);

